<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/sh"
    android:padding="16dp"
    android:background="#525454"
    tools:context=".ShareActivity">

    <!-- Title for Share Activity -->
    <TextView
        android:id="@+id/shareTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share This App"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Short Description Text -->
    <TextView
        android:id="@+id/shareDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share this app with your friends on any platform!"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shareTitle"
        android:layout_marginTop="24dp"/>

    <!-- Share Button -->
    <Button
        android:id="@+id/shareButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Share App"
        android:backgroundTint="#B8ABFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shareDescription"
        android:layout_marginTop="32dp"
        android:onClick="shareApp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
