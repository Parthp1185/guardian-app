<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sosm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".sosmessage"
    android:padding="24dp"
    android:background="@color/white">

    <!-- Logo -->
    <ImageView
        android:id="@+id/sosLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/img"
        android:contentDescription="SOS Icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/sosTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SOS Message"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        app:layout_constraintTop_toBottomOf="@id/sosLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Description -->
    <TextView
        android:id="@+id/sosDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please enter your emergency message below"
        android:textColor="@color/secondary_text"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/sosTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- SOS Message Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/sosMessageCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/sosDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Message Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/messageInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your emergency message"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/messageInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:maxLength="150"
                    android:paddingVertical="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Character Counter -->
            <TextView
                android:id="@+id/charCountMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150 characters remaining"
                android:textColor="@color/secondary_text"
                android:textSize="14sp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp" />

            <!-- Save Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Message"
                android:textColor="@color/white"
                android:background="@drawable/button_background"
                android:paddingVertical="12dp"
                android:onClick="saveSosMessage"
                android:layout_marginTop="24dp"
                android:textAllCaps="false"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Current Message Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/currentMessageCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sosMessageCard"></androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>